<% content_for :title, "Home" %>

<section class="hero-bg d-flex align-items-center">
  <div class="container text-center text-white">
    <span class="badge bg-dark bg-opacity-50 mb-3 px-3 py-2 rounded-pill">Fine Dining Experience</span>
    <h1 class="display-3 fw-bold mb-4">Taste The <span class="text-gold">Extraordinary</span></h1>
    <p class="lead mb-5 mx-auto" style="max-width: 600px;">
      Discover a symphony of flavors crafted from the freshest local ingredients. Reserve your table for an unforgettable culinary journey.
    </p>
    <div class="d-flex justify-content-center gap-3 flex-wrap">
   
    </div>
  </div>
</section>

<section class="py-5 bg-light">
  <div class="container">
    <div class="d-flex align-items-end justify-content-between gap-3 mb-4">
      <div>
        <p class="text-uppercase text-muted small mb-1">Restaurants</p>
        <h2 class="h3 fw-bold mb-0">All restaurants</h2>
      </div>
      <span class="text-muted"><%= pluralize(@restaurants.size, "restaurant") %></span>
    </div>

    <% if @restaurants.any? %>
      <div class="row g-4">
        <% @restaurants.each do |restaurant| %>
          <div class="col-12 col-md-6 col-xl-4">
            <div class="card h-100 border-0 shadow-sm">
              <div class="card-body d-flex flex-column">
                <h3 class="h5 fw-bold mb-3"><%= restaurant.name %></h3>
                <p class="mb-2 text-muted"><%= restaurant.address %></p>
                <p class="mb-4 text-muted"><%= restaurant.phone %></p>

                <div class="mt-auto">
                  <%= link_to "View details", restaurant_path(restaurant), class: "btn btn-dark" %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="alert alert-light border mb-0">
        No restaurants are available yet.
      </div>
    <% end %>
  </div>
</section>
