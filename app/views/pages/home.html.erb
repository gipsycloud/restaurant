<% content_for :title, "Home" %>

<% total_tables = @restaurants.sum { |restaurant| restaurant.tables.size } %>
<% total_menu_items = @restaurants.sum { |restaurant| restaurant.menus.size } %>

<div class="home-page">
  <section class="home-hero">
    <div class="container">
      <div class="row align-items-center g-5">
        <div class="col-lg-7">
          <span class="home-kicker"><i class="bi bi-stars me-2"></i>Restaurant operations platform</span>
          <h1>Run every service<br>with <span>confidence.</span></h1>
          <p class="home-hero-copy">A simple command center for the restaurants, tables, orders, and guests that make every service memorable.</p>
          <div class="d-flex flex-wrap gap-3">
            <%= link_to restaurants_path, class: "home-btn home-btn-gold" do %><i class="bi bi-grid-1x2 me-2"></i>Explore restaurants<% end %>
            <% if @restaurants.any? %>
              <%= link_to restaurant_path(@restaurants.first), class: "home-btn home-btn-outline" do %>Open first dashboard <i class="bi bi-arrow-up-right ms-2"></i><% end %>
            <% end %>
          </div>
        </div>
        <div class="col-lg-5">
          <div class="home-hero-panel">
            <div class="home-panel-top"><span class="home-live-dot"></span><span>System overview</span><i class="bi bi-bar-chart-line ms-auto"></i></div>
            <div class="home-panel-title"><span>Today at a glance</span><i class="bi bi-arrow-up-right"></i></div>
            <div class="home-overview-grid">
              <div><strong><%= @restaurants.size %></strong><small>Locations</small></div>
              <div><strong><%= total_tables %></strong><small>Tables managed</small></div>
              <div><strong><%= total_menu_items %></strong><small>Menu items</small></div>
              <div><strong>24/7</strong><small>Always ready</small></div>
            </div>
            <div class="home-panel-foot"><i class="bi bi-shield-check"></i> Everything in one place</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="home-locations">
    <div class="container py-5">
      <div class="d-flex flex-column flex-sm-row align-items-sm-end justify-content-between gap-3 mb-4">
        <div><p class="home-eyebrow mb-1">Your network</p><h2 class="mb-0">Choose a location</h2></div>
        <%= link_to restaurants_path, class: "home-text-link" do %>View all restaurants <i class="bi bi-arrow-right ms-1"></i><% end %>
      </div>
      <% if @restaurants.any? %>
        <div class="row g-4">
          <% @restaurants.each do |restaurant| %>
            <div class="col-12 col-md-6 col-xl-4">
              <article class="home-location-card h-100">
                <div class="home-location-head"><div class="home-location-avatar"><%= restaurant.name.first.upcase %></div><span><i class="home-live-dot"></i> Active</span></div>
                <div class="home-location-body">
                  <p class="home-eyebrow mb-2">Dining location</p>
                  <h3><%= restaurant.name %></h3>
                  <p class="home-location-address"><i class="bi bi-geo-alt me-2"></i><%= restaurant.address %></p>
                  <div class="home-location-meta"><span><i class="bi bi-grid-3x3-gap"></i><%= restaurant.tables.size %> tables</span><span><i class="bi bi-journal-text"></i><%= restaurant.menus.size %> menu items</span></div>
                </div>
                <%= link_to restaurant_path(restaurant), class: "home-location-link" do %>Open dashboard <i class="bi bi-arrow-up-right"></i><% end %>
              </article>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="home-empty"><i class="bi bi-shop"></i><h3>No restaurants available</h3><p class="home-muted mb-0">Your restaurant locations will appear here when they are added.</p></div>
      <% end %>
    </div>
  </section>
</div>
