<!-- app/views/layouts/application.html.erb -->
<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= content_for?(:title) ? "#{yield(:title)} | " : "" %>The Garden Kitchen</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Experience exquisite dining at The Garden Kitchen. Fresh ingredients, unforgettable flavors.">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  
  <!-- External CSS -->
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  
  <!-- Fonts & Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
  
  <%= javascript_importmap_tags if respond_to?(:javascript_importmap_tags) %>
</head>
<body>

  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark nav-custom fixed-top shadow-lg">
    <div class="container">
      <%= link_to "The Garden Kitchen", root_path, class: "navbar-brand fw-bold fs-4" %>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNavDropdown">
        <ul class="navbar-nav ms-auto align-items-center">
          <li class="nav-item">
            <%= link_to "Home", root_path, class: "nav-link #{current_page?(root_path) ? 'active text-gold' : ''}" %>
          </li>
          <li class="nav-item">
            <%= link_to "SideKiq", sidekiq_web_path, class: "nav-link #{current_page?(menu_path) ? 'active text-gold' : ''}" %>
          </li>
          <li class="nav-item">
            <%= link_to "Contact", contact_path, class: "nav-link #{current_page?(contact_path) ? 'active text-gold' : ''}" %>
          </li>
          <li class="nav-item ms-lg-3">
            <%#= link_to new_restaurant_reservation_path, class: "btn btn-gold px-4" do %>
              <i class="bi bi-calendar2-check me-1"></i> Book a Table
            <%# end %>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <main>
    <%= yield %>
  </main>

  <!-- JavaScript -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>