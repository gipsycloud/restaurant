<div class="mt-4 border-top border-secondary pt-3">
  <h6 class="text-white mb-3"><i class="bi bi-file-earmark-pdf text-gold me-2"></i>Receipt (Schema: receipts)</h6>
  
  <% if @order.receipt.present? %>
    <!-- If the job finished and the DB record exists -->
    <div class="d-flex justify-content-between align-items-center bg-dark p-3 rounded border border-secondary">
      <div>
        <small class="text-success"><i class="bi bi-check-circle me-1"></i>Generated</small><br>
        <small class="text-muted"><i class="bi bi-clock me-1"></i><%= @order.receipt.generated_at.strftime('%b %d, %I:%M %p') %></small>
      </div>
      <%= link_to @order.receipt.pdf_url, class: "btn btn-gold btn-sm", target: "_blank" do %>
        <i class="bi bi-download me-1"></i> View PDF
      <% end %>
			<%= button_to generate_receipt_restaurant_order_path(@restaurant, @order), method: :post, class: "btn btn-gold btn-sm" do %>
        <i class="bi bi-printer me-1"></i> Generate PDF (Sidekiq)
      <% end %>
    </div>
  <% else %>
    <!-- If the receipt hasn't been generated yet -->
    <div class="text-center py-3">
      <small>No receipt generated yet.</small><br>
      <%= button_to generate_receipt_restaurant_order_path(@restaurant, @order), method: :post, class: "btn btn-gold btn-sm" do %>
        <i class="bi bi-printer me-1"></i> Generate PDF (Sidekiq)
      <% end %>
    </div>
  <% end %>
</div>