<% content_for :title, "Orders" %>

<% total_orders = @restaurant.orders.count %>
<% pending_orders = @restaurant.orders.pending.count %>
<% preparing_orders = @restaurant.orders.preparing.count %>
<% ready_orders = @restaurant.orders.ready.count %>
<% completed_orders = @restaurant.orders.completed.count %>
<% today_orders = @restaurant.orders.where(created_at: Time.zone.today.all_day).count %>

<div class="orders-page">
  <div class="container py-5">
    <div class="orders-heading d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-4 mb-4">
      <div>
        <%= link_to restaurant_path(@restaurant), class: "orders-back-link" do %>
          <i class="bi bi-arrow-left me-2"></i> <%= @restaurant.name %>
        <% end %>
        <p class="orders-eyebrow mt-4 mb-1">Kitchen workflow</p>
        <h1 class="mb-1">Orders</h1>
        <p class="orders-muted mb-0">Track every ticket from prep to completion.</p>
      </div>
      <div class="d-flex gap-2 flex-wrap">
        <%= link_to restaurant_orders_path(@restaurant), class: "orders-btn orders-btn-quiet" do %>
          <i class="bi bi-arrow-clockwise me-1"></i> Reset
        <% end %>
        <%= link_to restaurant_orders_path(@restaurant, status: "pending"), class: "orders-btn orders-btn-primary" do %>
          <i class="bi bi-lightning-charge-fill me-1"></i> Pending queue
        <% end %>
      </div>
    </div>

    <div class="row g-3 mb-4">
      <% [["Total orders", total_orders, "bi-receipt", "gold"], ["Today", today_orders, "bi-calendar-day", "blue"], ["Pending", pending_orders, "bi-hourglass-split", "yellow"], ["Preparing", preparing_orders, "bi-fire", "orange"], ["Ready", ready_orders, "bi-check2-circle", "green"], ["Completed", completed_orders, "bi-bag-check", "muted"]].each do |label, value, icon, color| %>
        <div class="col-6 col-xl-2">
          <div class="queue-stat queue-stat-<%= color %>">
            <i class="bi <%= icon %>"></i>
            <small><%= label %></small>
            <strong><%= value %></strong>
          </div>
        </div>
      <% end %>
    </div>

    <section class="order-filter-panel mb-4">
      <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
        <div>
          <p class="orders-eyebrow mb-1">Order queue</p>
          <h2 class="h5 mb-0">Filter by status</h2>
        </div>
        <div class="order-filter-list">
          <%= link_to "All", restaurant_orders_path(@restaurant), class: "order-filter #{'active' if params[:status].blank?}" %>
          <% Order.statuses.keys.each do |status| %>
            <%= link_to restaurant_orders_path(@restaurant, status: status), class: "order-filter #{'active' if params[:status] == status}" do %>
              <%= status.humanize %><span><%= @restaurant.orders.public_send(status).count %></span>
            <% end %>
          <% end %>
        </div>
      </div>
    </section>

    <% if @orders.any? %>
      <div class="order-queue">
        <div class="order-queue-header d-none d-lg-grid">
          <span>Order</span><span>Guest / table</span><span>Progress</span><span>Total</span><span></span>
        </div>
        <% @orders.each do |order| %>
          <% progress_width = { "pending" => 20, "confirmed" => 35, "preparing" => 60, "ready" => 85, "completed" => 100 }.fetch(order.status, 10) %>
          <article class="order-queue-row">
            <div class="order-identity">
              <div class="order-icon"><i class="bi bi-receipt"></i></div>
              <div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                  <strong>Order #<%= order.id %></strong>
                  <span class="order-pill order-pill-<%= order.status %>"><%= order.status.humanize %></span>
                </div>
                <small class="orders-muted"><%= time_ago_in_words(order.created_at) %> ago</small>
              </div>
            </div>
            <div class="order-guest">
              <strong><%= order.reservation&.customer_name.presence || "Walk-in guest" %></strong>
              <small class="orders-muted"><i class="bi bi-table me-1"></i><%= order.table&.table_number.present? ? "Table #{order.table.table_number}" : "No table" %></small>
            </div>
            <div class="order-progress">
              <div class="d-flex justify-content-between mb-2"><small class="orders-muted"><%= order.order_items.size %> items</small><small class="orders-muted"><%= progress_width %>%</small></div>
              <div class="progress-track"><span style="width: <%= progress_width %>%"></span></div>
              <small class="orders-muted order-items-summary"><%= truncate(order.menus.map(&:name).join(", "), length: 70) %></small>
            </div>
            <div class="order-amount">
              <strong>₱<%= number_with_precision(order.total_amount || 0, precision: 2) %></strong>
              <span class="payment-pill payment-pill-<%= order.payment_status %>"><%= order.payment_status.humanize %></span>
            </div>
            <div class="order-row-actions">
              <%= link_to restaurant_order_path(@restaurant, order), class: "orders-btn orders-btn-outline" do %><i class="bi bi-arrow-up-right"></i><span class="d-none d-sm-inline">Details</span><% end %>
              <% if order.pending? %>
                <%= button_to restaurant_order_path(@restaurant, order), method: :patch, params: { order: { status: "preparing" } }, class: "orders-btn orders-btn-action" do %><i class="bi bi-play-fill"></i><span class="d-none d-sm-inline">Start prep</span><% end %>
              <% elsif order.preparing? %>
                <%= button_to restaurant_order_path(@restaurant, order), method: :patch, params: { order: { status: "ready" } }, class: "orders-btn orders-btn-action" do %><i class="bi bi-check2"></i><span class="d-none d-sm-inline">Ready</span><% end %>
              <% elsif order.ready? %>
                <%= button_to restaurant_order_path(@restaurant, order), method: :patch, params: { order: { status: "completed" } }, class: "orders-btn orders-btn-action" do %><i class="bi bi-bag-check"></i><span class="d-none d-sm-inline">Complete</span><% end %>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="order-empty"><i class="bi bi-inbox"></i><h2 class="h5">No orders found</h2><p class="orders-muted mb-0">Try a different filter or wait for the next ticket to arrive.</p></div>
    <% end %>
  </div>
</div>
