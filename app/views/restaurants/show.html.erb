<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="mb-0"><i class="bi bi-speedometer2 me-2"></i><%= @restaurant.name %></h2>
    <span class="text-muted"><i class="bi bi-geo-alt me-1"></i><%= @restaurant.address %></span>
  </div>
  <span class="badge bg-dark fs-6 px-3 py-2">POS Dashboard</span>
</div>

<!-- Stats Cards Row -->
<div class="row g-3 mb-4">
  <!-- Today's Orders -->
  <div class="col-md-3">
    <div class="card border-0 shadow-sm bg-primary text-white">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h6 class="card-title mb-1 opacity-75">Today's Orders</h6>
            <h2 class="mb-0 fw-bold"><%= @today_orders.count %></h2>
          </div>
          <i class="bi bi-receipt fs-1 opacity-50"></i>
        </div>
      </div>
    </div>
  </div>

  <!-- Available Tables -->
  <div class="col-md-3">
    <div class="card border-0 shadow-sm bg-info text-white">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h6 class="card-title mb-1 opacity-75">Available Tables</h6>
            <h2 class="mb-0 fw-bold"><%= @available_tables %> / <%= @total_tables %></h2>
          </div>
          <i class="bi bi-table fs-1 opacity-50"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <%= link_to restaurant_tables_path(@restaurant), class: "btn btn-outline-info w-100 py-3 shadow-sm" do %>
      <i class="bi bi-grid-3x3-gap fs-4 d-block mb-1"></i> View Tables
    <% end %>
  </div>

  <div class="col-md-3">
    <%= link_to restaurant_orders_path(@restaurant), class: "btn btn-outline-dark w-100 py-3 shadow-sm" do %>
      <i class="bi bi-list-check fs-4 d-block mb-1"></i> All Orders
    <% end %>
  </div>
</div>

<!-- Quick Action Buttons -->
<div class="row g-3 mb-4">
  <div class="col-md-3">
    <%#= link_to restaurant_users_path(@restaurant), class: "btn btn-outline-success w-100 py-3 shadow-sm" do %>
      <!-- i class="bi bi-person-gear fs-4 d-block mb-1"></i> Manage Staff -->
    <%# end %>
  </div>
</div>

  <div class="col-md-6">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-clock-history me-2 text-dark"></i>Recent Orders</h5>
        <%= link_to "View All", restaurant_orders_path(@restaurant), class: "btn btn-sm btn-outline-dark" %>
      </div>
      <div class="card-body p-0">
        <ul class="list-group list-group-flush">
          <% recent_orders = @restaurant.orders.order(created_at: :desc).limit(5) %>
          <% if recent_orders.empty? %>
            <li class="list-group-item text-center text-muted py-4">No orders yet</li>
          <% end %>
          <% recent_orders.each do |order| %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <div>
                <strong>Order #<%= order.id %></strong><br>
                <small class="text-muted">Table <%= order.table.table_number %> &bull; <%= time_ago_in_words(order.created_at) %> ago</small>
              </div>
              <div class="text-end">
                <strong>$<%= order.total_amount.round(2) %></strong><br>
                <span class="badge <%= order.payment_status == 'paid' ? 'bg-success' : 'bg-warning text-dark' %>">
                  <%#= order.payment_status.capitalize %>
                </span>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</div>